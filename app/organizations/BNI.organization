      <userName>User2</userName>
      <roleName>Role1</roleName>
      <groupName>BNI-IT</groupName>
    </membership>
    <membership>
      <userName>User1</userName>
      <roleName>Role1</roleName>
      <groupName>BNI-IT</groupName>
    </membership>
